{
  "name": "bcs_store",
  "version": "2.2.6",
  "description": "BCS Store: BMW MGU app and tool store by BCS Automotive Solutions (GPL-3.0-or-later; based on Robert Nisipeanu MGU Store v0.9.40)",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 26214400,
    "cpuLimit": 30,
    "memoryThresholdKB": 131072,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "STOR",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "fonts",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json",
    "CHANGELOG.md",
    "LICENSES.txt"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "author": "BCS Automotive Solutions",
  "license": "GPL-3.0-or-later",
  "mguLocalOnly": true,
  "mguHmi": [
    "ID7",
    "ID8"
  ]
}
